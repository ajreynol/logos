; A user sort named `Type`, as Verus emits, shadows the name of Eunoia's sort of
; sorts.  The type of a later `declare-sort` is built from the configuration's
; sort of sorts, not by looking up the name `Type`, so `Poly` below is a sort
; (and this proof is `correct`) rather than a constant of the user's `Type`
; (which would make it `incomplete`).
(declare-sort Type 0)
(declare-sort Poly 0)
(declare-datatypes ((Range 0)) (((mkRange (start Poly) (end Poly)))))
(declare-const const_int (-> Type Int))
(declare-const N Type)
(declare-const I (-> Int Poly))
(define @t1 () (I 0))
(define @t2 () (= (start (mkRange @t1 (I (const_int N)))) @t1))
(define @t3 () (not @t2))
(assume @p1 @t3)
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args (@t1))
(step @p4 :rule refl :args (@t1))
(step @p5 :rule dt-collapse-selector :args (@t2))
(step @p6 :rule cong :premises (@p5 @p4) :args (@t2))
(step @p7 :rule trans :premises (@p6 @p3))
(step @p8 :rule cong :premises (@p7) :args (@t3))
(step @p9 :rule trans :premises (@p8 @p2))
(step @p10 false :rule eq_resolve :premises (@p1 @p9))
